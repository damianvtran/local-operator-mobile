import { registerSourceResolver } from "/Users/damian/workspace/mobile-i18n-d5aaf8ba6ba5/mobile-i18n/scripts/lib/load-src.ts";
registerSourceResolver();
const { parseMessage, formatMessage } = await import("/Users/damian/workspace/mobile-i18n-d5aaf8ba6ba5/mobile-i18n/src/i18n/messages.ts");
const proposed: Record<string,string> = {
  "head.next": "{head} · prochaine échéance {label}",
  "cadence.left": "{cadence} · {remaining, plural, one {# envoi restant} many {# d’envois restants} other {# envois restants}}",
  "summary.monitors_armed": "{count, plural, one {# active} many {# de surveillances actives} other {# actives}}",
  "summary.wakes": "{count, plural, one {# planifié} many {# de réveils planifiés} other {# planifiés}}",
  "tail.failed": "{count, plural, one {# échec} many {# d’échecs} other {# échecs}}",
  "summary.monitors_attention": "{broken} sur {total} en alerte",
};
const r = (msg: string, args: Record<string,string|number>) => formatMessage(parseMessage(msg), args, "fr");
for (const [key, msg] of Object.entries(proposed)) {
  const p = parseMessage(msg);
  console.log(`PROPOSED ${key}: parses=PASS params=${JSON.stringify([...p.params.entries()].sort())}`);
}
console.log("PROPOSED head.next:", r(proposed["head.next"], { head: "3 réveils", label: "dans 4m" }), "|", r(proposed["head.next"], { head: "1 surveillance", label: "dans 30s" }));
for (const n of [0,1,2,1000000,1500000]) {
  console.log(`PROPOSED n=${n}: cadence.left='${r(proposed["cadence.left"], { cadence: "tous les 1h", remaining: n })}' | armed='${r(proposed["summary.monitors_armed"], { count: n })}' | wakes='${r(proposed["summary.wakes"], { count: n })}' | failed='${r(proposed["tail.failed"], { count: n })}'`);
}
console.log("PROPOSED attention:", r(proposed["summary.monitors_attention"], { broken: 1, total: 1 }), "|", r(proposed["summary.monitors_attention"], { broken: 2, total: 5 }));
