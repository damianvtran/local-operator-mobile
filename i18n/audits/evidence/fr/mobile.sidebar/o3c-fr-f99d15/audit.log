import { readFileSync } from "node:fs";
import { createHash } from "node:crypto";
const W = "/Users/damian/local-operator-mobile/.worktrees/i18n-m3-s2a";
const { parseMessage, formatMessage } = await import(W + "/src/i18n/messages.ts");
const draftPath = "/Users/damian/.local-operator/sessions/0942405d8cd5/scratchpad/o3c/draft-fr.json";
const briefPath = "/Users/damian/.local-operator/sessions/162198c78bcb/scratchpad/o3c-translation-brief.json";
const sha = (p: string) => createHash("sha256").update(readFileSync(p)).digest("hex");
console.log("draft sha256", sha(draftPath)); console.log("brief sha256", sha(briefPath));
for (const f of ["mobile.sidebar.json","mobile.sidebar.context.json"]) console.log("en", f, sha(`${W}/src/i18n/catalogues/en/${f}`));
const draft = JSON.parse(readFileSync(draftPath, "utf8")); const brief = JSON.parse(readFileSync(briefPath, "utf8"));
const en = JSON.parse(readFileSync(`${W}/src/i18n/catalogues/en/mobile.sidebar.json`, "utf8"));
const keys = brief.keys.map((k: any) => k.key); const dk = Object.keys(draft.values);
console.log("missing", keys.filter((k: string) => !dk.includes(k)), "extra", dk.filter(k => !keys.includes(k)));
const sig = (p: any) => JSON.stringify(p);
for (const k of keys) {
  const b = brief.keys.find((x: any) => x.key === k); const v = draft.values[k];
  if (en[k] !== b.english) console.log("BRIEF/EN MISMATCH", k);
  let pe: any, pf: any;
  try { pe = parseMessage(en[k]); pf = parseMessage(v); } catch (e) { console.log("PARSE FAIL", k, String(e)); continue; }
  const sh = (m: any) => JSON.stringify({params: [...m.params.entries()].sort(), selects: m.nodes.filter((n: any) => n.type === "select").map((n: any) => [n.name, (n.options instanceof Map ? [...n.options.keys()] : Object.keys(n.options)).sort()])}); const argsE = sh(pe); const argsF = sh(pf);
  const nfc = v === v.normalize("NFC");
  const samples: any[] = k.endsWith("waiting") ? [{kind:"approval"},{kind:"question"}] : k.endsWith("on_device") ? [{device:"Studio Mac"}] : [{}];
  const out = samples.map(a => formatMessage(pf, a, "fr"));
  const w = Math.max(...out.map((s: string) => [...s].length));
  console.log(k, "| nfc", nfc, "| args", argsF === argsE ? "same "+argsF : `DIFF en=${argsE} fr=${argsF}`, "| out", JSON.stringify(out), "| width", w, "/", b.width_hint_chars, w > b.width_hint_chars ? "OVER" : "ok", "| lower", v === v.toLowerCase() || k.endsWith("on_device"), "| edge-punct", /^[\s,.;:]|[\s,.;:]$/.test(v));
}
const pat = new RegExp(brief.redaction_scan.pattern.replace(/^\(\?i\)/, ""), "i");
const scan = (s: string) => (s.match(new RegExp(pat.source, "gi")) ?? []).length;
const briefNoPat = JSON.stringify({ ...brief, redaction_scan: { ...brief.redaction_scan, pattern: "" } });
console.log("redaction hits draft", scan(readFileSync(draftPath, "utf8")), "brief(excl pattern)", scan(briefNoPat), "en", scan(readFileSync(`${W}/src/i18n/catalogues/en/mobile.sidebar.json`,"utf8")));
// negative controls
for (const bad of ["{kind, select, approval {x}}", "{kind, select, approval {x} other {y}", "sur {appareil}"]) { try { const p = parseMessage(bad); console.log("neg", bad, "parsed", JSON.stringify(p).slice(0,120)); } catch (e) { console.log("neg", bad, "REJECTED", String(e).slice(0,100)); } }
