import { readFileSync, realpathSync } from "node:fs";
import { join } from "node:path";
import { createHash } from "node:crypto";
import { registerSourceResolver } from "/Users/damian/workspace/mobile-i18n-d5aaf8ba6ba5/mobile-i18n/scripts/lib/load-src.ts";
registerSourceResolver();
const { parseMessage } = await import("/Users/damian/workspace/mobile-i18n-d5aaf8ba6ba5/mobile-i18n/src/i18n/messages.ts");
const root = "/Users/damian/workspace/mobile-i18n-d5aaf8ba6ba5/mobile-i18n";
const summary: any[] = [];
for (const namespace of ["mobile.home", "mobile.schedules"]) {
  const paths = {
    en: `src/i18n/catalogues/en/${namespace}.json`,
    context: `src/i18n/catalogues/en/${namespace}.context.json`,
    target: `src/i18n/catalogues/fr/${namespace}.json`,
  };
  for (const [kind, rel] of Object.entries(paths)) {
    const bytes = readFileSync(join(root, rel));
    console.log(`SHA256 ${namespace} ${kind} ${rel} ${createHash("sha256").update(bytes).digest("hex")}`);
  }
  const en = JSON.parse(readFileSync(join(root, paths.en), "utf8"));
  const ctx = JSON.parse(readFileSync(join(root, paths.context), "utf8"));
  const fr = JSON.parse(readFileSync(join(root, paths.target), "utf8"));
  console.log(`JSON ${namespace}: en/context/target parse PASS`);
  const enKeys = Object.keys(en), frKeys = Object.keys(fr), ctxKeys = Object.keys(ctx);
  console.log(`KEYS ${namespace}: en=${enKeys.length} target=${frKeys.length} context=${ctxKeys.length}; missing=${JSON.stringify(enKeys.filter(k=>!(k in fr)))}; extra=${JSON.stringify(frKeys.filter(k=>!(k in en)))}; context_parity=${enKeys.length===ctxKeys.length && enKeys.every(k=>k in ctx)}`);
  let failures = 0;
  for (const key of enKeys) {
    let ep, fp;
    try { ep = parseMessage(en[key]); } catch (e) { console.log(`SOURCE_PARSE_FAIL ${key}: ${e}`); failures++; continue; }
    try { fp = parseMessage(fr[key]); } catch (e) { console.log(`TARGET_PARSE_FAIL ${key}: ${e}`); failures++; continue; }
    const params = (p: any) => JSON.stringify([...p.params.entries()].sort());
    const walk = (nodes: any[]): any[] => nodes.flatMap(n => {
      if (n.type === "plural" || n.type === "select") return [[n.type, n.name, [...n.options.keys()].sort()], ...[...n.options.values()].flatMap(walk)];
      if (n.type === "argument") return [["argument", n.name]];
      if (n.type === "number") return [["number"]];
      return [];
    });
    const paramOK = params(ep) === params(fp);
    const sourceNodes = walk(ep.nodes), targetNodes = walk(fp.nodes);
    const argumentOrder = (nodes:any[]) => nodes.filter(n=>n[0]==="argument" || n[0]==="plural" || n[0]==="select").map(n=>[n[0],n[1]]);
    const orderOK = JSON.stringify(argumentOrder(sourceNodes)) === JSON.stringify(argumentOrder(targetNodes));
    const enPlurals = sourceNodes.filter(n=>n[0]==="plural"), frPlurals = targetNodes.filter(n=>n[0]==="plural");
    const enSelects = sourceNodes.filter(n=>n[0]==="select"), frSelects = targetNodes.filter(n=>n[0]==="select");
    const pluralsOK = enPlurals.length===frPlurals.length && frPlurals.every(n=>JSON.stringify(n[2])===JSON.stringify(["many","one","other"]));
    const selectsOK = JSON.stringify(enSelects.map(n=>[n[1],n[2]]))===JSON.stringify(frSelects.map(n=>[n[1],n[2]]));
    const hashes = (s:string) => (s.match(/#/g)||[]).length;
    const hashOK = hashes(en[key])===hashes(fr[key]);
    const tech = (s:string) => s.match(/`[^`]+`|--[A-Za-z0-9_-]+|https?:\/\/\S+|\bLinear MCP\b/g) || [];
    const techOK = JSON.stringify(tech(en[key]))===JSON.stringify(tech(fr[key]));
    const bidiOK = !/[\u202A-\u202E\u2066-\u2069]/.test(fr[key]);
    const asciiApostropheOK = !fr[key].includes("'");
    const punctuationIssues = [...fr[key].matchAll(/([\s\S])([:;!?])/g)].filter(m=>!(m[1]==="\u202f" || /[\d)]/.test(m[1]))).map(m=>m[0]);
    const punctuationOK = punctuationIssues.length===0;
    const mechanicalOK = paramOK && orderOK && pluralsOK && selectsOK && hashOK && techOK && bidiOK && asciiApostropheOK && punctuationOK;
    if (!mechanicalOK) failures++;
    console.log(`MECHANICAL ${key}: ${mechanicalOK?"PASS":"FAIL"}; params=${paramOK}; order=${orderOK}; fr_plurals=${pluralsOK}; selects=${selectsOK}; hashes=${hashOK}; tech=${techOK}; bidi=${bidiOK}; apostrophe=${asciiApostropheOK}; punctuation=${punctuationOK}; chars_en=${[...en[key]].length}; chars_fr=${[...fr[key]].length}`);
  }
  summary.push({namespace, keys: enKeys.length, mechanical_failures: failures});
}
const pr = new Intl.PluralRules("fr");
console.log(`CLDR fr resolvedCategories=${JSON.stringify(pr.resolvedOptions().pluralCategories)}; samples=${JSON.stringify([0,1,2,1000000,1500000,2000000].map(n=>[n,pr.select(n)]))}`);
console.log(`SUMMARY ${JSON.stringify(summary)}`);
for (const namespace of ["mobile.home", "mobile.schedules"]) {
  const fr = JSON.parse(readFileSync(join(root, `src/i18n/catalogues/fr/${namespace}.json`), "utf8"));
  for (const [key,value] of Object.entries(fr)) {
    const bad = [...String(value).matchAll(/([\s\S])([:;!?])/g)].filter(m=>!(m[1]==="\u202f" || /[\d)]/.test(m[1]))).map(m=>({before:m[1],before_codepoint:m[1].codePointAt(0).toString(16),punctuation:m[2]}));
    if (bad.length) console.log(`PUNCTUATION_DETAIL ${key} ${JSON.stringify(bad)}`);
  }
}
const home = JSON.parse(readFileSync(join(root,"src/i18n/catalogues/fr/mobile.home.json"),"utf8"));
for (const [key,value] of Object.entries(home)) {
  if (key.includes("suggestion.")) console.log(`FIT_SUGGESTION ${key} chars=${String(value).length} budget=24 ${String(value).length<=24?"PASS":"FAIL"}`);
  if (key.includes("tip.")) console.log(`FIT_TIP ${key} chars=${String(value).length} budget=48 ${String(value).length<=48?"PASS":"FAIL"}`);
}
