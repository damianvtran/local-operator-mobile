## Appendix A. Harness source actually executed above (reproduction)
==================================================================
--- audit2.ts ---
/**
 * Round-2 independent audit harness for the French mobile catalogues.
 * Reads the CURRENT bytes; uses the app's own parser (src/i18n/messages.ts),
 * never a third-party formatter.
 */
import { readFileSync } from "node:fs";
import { createHash } from "node:crypto";
import { parseMessage, formatMessage, pluralCategory } from "/Users/damian/workspace/mobile-i18n-d5aaf8ba6ba5/mobile-i18n/src/i18n/messages.ts";

const ROOT = "/Users/damian/workspace/mobile-i18n-d5aaf8ba6ba5/mobile-i18n";
const sha = (p: string) => createHash("sha256").update(readFileSync(p)).digest("hex");
const read = (p: string) => readFileSync(p, "utf8");
const hex = (s: string) => [...s].map((c) => {
  const cp = c.codePointAt(0)!;
  return cp < 128 && cp >= 32 ? c : `U+${cp.toString(16).toUpperCase().padStart(4, "0")}`;
}).join("");

type Cat = Record<string, string>;

const namespaces = ["mobile.home", "mobile.schedules"] as const;

console.log("== INPUT HASHES (sha256) ==");
for (const ns of namespaces) {
  for (const p of [
    `src/i18n/catalogues/en/${ns}.json`,
    `src/i18n/catalogues/en/${ns}.context.json`,
    `src/i18n/catalogues/fr/${ns}.json`,
  ]) {
    console.log(`${sha(`${ROOT}/${p}`)}  ${p}`);
  }
}

// ---- duplicate-key detection (JSON.parse silently keeps the last) ----
function duplicateKeys(raw: string): string[] {
  const seen = new Map<string, number>();
  // shallow scan: catalogue values never nest objects, so a line scan is exact here
  for (const line of raw.split("\n")) {
    const m = line.match(/^\s*"([^"]+)":/);
    if (m) seen.set(m[1], (seen.get(m[1]) ?? 0) + 1);
  }
  return [...seen.entries()].filter(([, n]) => n > 1).map(([k]) => k);
}

const BIDI = /[\u202A-\u202E\u2066-\u2069\u200E\u200F\u061C]/;
const ICU_CATEGORIES = ["zero", "one", "two", "few", "many", "other"];

/** Branch keys of the plural/select named `argName`, read off the parsed AST
 *  (authoritative — the same tree the renderer walks). */
function branchNames(parsed: any, argName: string): string[] {
  const out: string[] = [];
  const walk = (nodes: readonly any[]) => {
    for (const n of nodes) {
      if ((n.type === "plural" || n.type === "select") && n.name === argName) {
        for (const k of n.options.keys()) out.push(k);
      }
      if (n.options) for (const body of n.options.values()) walk(body);
    }
  };
  walk(parsed.nodes);
  return out;
}

let problems = 0;
for (const ns of namespaces) {
  const en: Cat = JSON.parse(read(`${ROOT}/src/i18n/catalogues/en/${ns}.json`));
  const ctx: Record<string, unknown> = JSON.parse(read(`${ROOT}/src/i18n/catalogues/en/${ns}.context.json`));
  const fr: Cat = JSON.parse(read(`${ROOT}/src/i18n/catalogues/fr/${ns}.json`));

  console.log(`\n===== ${ns} =====`);
  console.log(`key counts: en=${Object.keys(en).length} context=${Object.keys(ctx).length} fr=${Object.keys(fr).length}`);
  console.log(`fr duplicate keys: ${JSON.stringify(duplicateKeys(read(`${ROOT}/src/i18n/catalogues/fr/${ns}.json`)))}`);
  const missing = Object.keys(en).filter((k) => !(k in fr));
  const extra = Object.keys(fr).filter((k) => !(k in en));
  const noCtx = Object.keys(en).filter((k) => !(k in ctx));
  console.log(`missing in fr: ${JSON.stringify(missing)}`);
  console.log(`extra in fr: ${JSON.stringify(extra)}`);
  console.log(`en keys without context: ${JSON.stringify(noCtx)}`);

  console.log("\n-- PER-KEY STRUCTURE --");
  for (const key of Object.keys(en)) {
    const e = en[key];
    const f = fr[key];
    if (f === undefined) continue;
    const ep = parseMessage(e);
    const fp = parseMessage(f);
    const eParams = [...ep.params.entries()].map(([n, k]) => `${n}:${k}`).sort();
    const fParams = [...fp.params.entries()].map(([n, k]) => `${n}:${k}`).sort();
    const namesEqual = eParams.join(",") === fParams.join(",");
    const eNames = [...ep.params.keys()].sort().join(",");
    const fNames = [...fp.params.keys()].sort().join(",");
    const nameOnlyEqual = eNames === fNames;
    const frBranches: string[] = [];
    for (const [n, kind] of fp.params) if (kind === "plural") frBranches.push(`${n}=[${branchNames(fp, n).join("|")}]`);
    for (const [n, kind] of fp.params) if (kind === "select") frBranches.push(`${n}=select[${branchNames(fp, n).join("|")}]`);
    const pluralCats = [...fp.params.entries()].filter(([, k]) => k === "plural").map(([n]) => {
      const b = branchNames(fp, n);
      const frCltd = ["one", "many", "other"].every((c) => b.includes(c));
      const hasFew = b.includes("few") || b.includes("two") || b.includes("zero");
      return `${n}:${frCltd ? "fr-CLDR-ok" : "MISSING-FR-CATEGORY"}${hasFew ? "+NON-FR-CATS" : ""}`;
    });
    const flags: string[] = [];
    if (!nameOnlyEqual) flags.push("PLACEHOLDER-NAME-MISMATCH");
    if (!namesEqual && nameOnlyEqual) flags.push(`TYPE-DIFF en[${eParams}] fr[${fParams}]`);
    if (BIDI.test(f)) flags.push("BIDI-CONTROL");
    if (f.includes("'")) flags.push("ASCII-APOSTROPHE");
    if (pluralCats.some((s) => s.includes("MISSING"))) flags.push("PLURAL-CATEGORY-GAP");
    console.log(`${key} | params en=[${eParams.join(" ")}] fr=[${fParams.join(" ")}]${frBranches.length ? " | branches " + frBranches.join(" ") : ""}${pluralCats.length ? " | " + pluralCats.join(" ") : ""}${flags.length ? " | FLAGS " + flags.join(" ") : " | ok"}`);
  }
}

// ---- executed plural renders ----
const COUNTS = [0, 1, 2, 1000000, 1500000];
const PLURAL_KEYS = [
  "mobile.schedules.count.monitors",
  "mobile.schedules.count.wakes",
  "mobile.schedules.cadence.left",
  "mobile.schedules.show_more.monitors",
  "mobile.schedules.show_more.wakes",
  "mobile.schedules.summary.monitors_armed",
  "mobile.schedules.summary.wakes",
  "mobile.schedules.tail.failed",
  "mobile.schedules.truncated",
] as const;

const frSchedules: Cat = JSON.parse(read(`${ROOT}/src/i18n/catalogues/fr/mobile.schedules.json`));
const enSchedules: Cat = JSON.parse(read(`${ROOT}/src/i18n/catalogues/en/mobile.schedules.json`));

console.log("\n===== EXECUTED PLURAL RENDERS (app parser, locale fr) =====");
console.log("pluralCategory(fr, n): " + COUNTS.map((n) => `${n}->${pluralCategory("fr", n)}`).join("  "));
console.log("pluralCategory(en, n): " + COUNTS.map((n) => `${n}->${pluralCategory("en", n)}`).join("  "));
for (const key of PLURAL_KEYS) {
  const text = frSchedules[key];
  const m = parseMessage(text);
  const pluralArg = [...m.params.entries()].find(([, k]) => k === "plural")?.[0];
  if (!pluralArg) { console.log(`${key}: NO PLURAL ARG`); continue; }
  const otherArgs = [...m.params.keys()].filter((n) => n !== pluralArg);
  for (const n of COUNTS) {
    const args: Record<string, string | number> = { [pluralArg]: n };
    for (const a of otherArgs) args[a] = a === "cadence" ? "tous les 1h" : a === "family" ? "wakes" : a === "total" ? 5 : a === "head" ? "3 réveils" : a === "label" ? "dans 4m" : "X";
    console.log(`RENDER fr ${key} ${pluralArg}=${n}: ${formatMessage(m, args, "fr")}`);
  }
}

// ---- composed fragments, using the app's own due/head keys ----
console.log("\n===== COMPOSED FRAGMENTS (dueLabel -> nextDueClause equivalent) =====");
const dueLabelFr = (seconds: number) => {
  const overdue = seconds < 0;
  const mag = Math.abs(seconds);
  let label: string;
  if (mag < 90) label = `${Math.floor(mag)}s`;
  else if (mag < 5400) label = `${Math.floor(mag / 60)}m`;
  else if (mag < 172800) label = `${Math.floor(mag / 3600)}h`;
  else label = `${Math.floor(mag / 86400)}d`;
  return formatMessage(parseMessage(frSchedules[overdue ? "mobile.schedules.due.overdue" : "mobile.schedules.due.ahead"]), { label }, "fr");
};
const nextDueClauseFr = (head: string, seconds: number) => {
  const label = dueLabelFr(seconds);
  const key = seconds < 0 ? "mobile.schedules.head.overdue" : "mobile.schedules.head.next";
  return formatMessage(parseMessage(frSchedules[key]), { head, label }, "fr");
};
const countWakes = (n: number) => formatMessage(parseMessage(frSchedules["mobile.schedules.count.wakes"]), { count: n }, "fr");
const countMonitors = (n: number) => formatMessage(parseMessage(frSchedules["mobile.schedules.count.monitors"]), { count: n }, "fr");
for (const [n, secs] of [[3, 240], [1, 30], [2, -7200], [1000000, 240]] as const) {
  console.log(`COMPOSE head wakes n=${n} secs=${secs}: ${nextDueClauseFr(countWakes(n), secs)}`);
  console.log(`COMPOSE head monitors n=${n} secs=${secs}: ${nextDueClauseFr(countMonitors(n), secs)}`);
}
console.log(`COMPOSE wakeDueWord overdue: ${dueLabelFr(-7200)}   ahead: ${dueLabelFr(240)}`);
const cadenceLeft = (cadence: string, remaining: number) =>
  formatMessage(parseMessage(frSchedules["mobile.schedules.cadence.left"]), { cadence, remaining }, "fr");
for (const r of [1, 2, 1000000]) console.log(`COMPOSE cadence.left remaining=${r}: ${cadenceLeft("tous les 1h", r)}`);
const attention = (broken: number, total: number) =>
  formatMessage(parseMessage(frSchedules["mobile.schedules.summary.monitors_attention"]), { broken, total }, "fr");
for (const [b, t] of [[1, 1], [2, 5], [0, 3]] as const) console.log(`COMPOSE monitors_attention ${b}/${t}: ${attention(b, t)}`);
const truncated = (shown: number, total: number, family: string) =>
  formatMessage(parseMessage(frSchedules["mobile.schedules.truncated"]), { shown, total, family }, "fr");
for (const [s, t, f] of [[3, 12, "wakes"], [1, 1, "monitors"], [3, 5, "monitors"]] as const) console.log(`COMPOSE truncated ${s}/${t}/${f}: ${truncated(s, t, f)}`);

// ---- EN counterparts for the same renders (same-code control) ----
console.log("\n===== SAME-CODE EN CONTROL (locale en) =====");
for (const key of PLURAL_KEYS) {
  const text = enSchedules[key];
  const m = parseMessage(text);
  const pluralArg = [...m.params.entries()].find(([, k]) => k === "plural")?.[0];
  if (!pluralArg) continue;
  const otherArgs = [...m.params.keys()].filter((n) => n !== pluralArg);
  for (const n of [0, 1, 1000000]) {
    const args: Record<string, string | number> = { [pluralArg]: n };
    for (const a of otherArgs) args[a] = a === "cadence" ? "every 1h" : a === "family" ? "wakes" : a === "total" ? 5 : a === "head" ? "3 wakes" : a === "label" ? "in 4m" : "X";
    console.log(`RENDER en ${key} ${pluralArg}=${n}: ${formatMessage(m, args, "en")}`);
  }
}

// ---- typography + tokens ----
console.log("\n===== TYPOGRAPHY / CHARACTER AUDIT =====");
for (const ns of namespaces) {
  const fr: Cat = JSON.parse(read(`${ROOT}/src/i18n/catalogues/fr/${ns}.json`));
  for (const [key, value] of Object.entries(fr)) {
    const notes: string[] = [];
    for (const ch of ["?", "!", ":", ";"]) {
      let i = -1;
      while ((i = value.indexOf(ch, i + 1)) >= 0) {
        const prev = value[i - 1];
        const prevCp = prev?.codePointAt(0);
        if (prev === " ") notes.push(`ASCII-SPACE-BEFORE ${ch} at ${i}`);
        else if (prevCp === 0x202f) { /* required narrow nbsp */ }
        else if (prevCp === 0xa0) notes.push(`NBSP(U+00A0)-BEFORE ${ch} at ${i}`);
      }
    }
    if (/[\u202A-\u202E\u2066-\u2069\u200E\u200F\u061C]/.test(value)) notes.push("BIDI-CONTROL");
    if (value.includes("'")) notes.push("ASCII-APOSTROPHE");
    if (/"/.test(value)) notes.push("ASCII-DOUBLE-QUOTE");
    if (/\.\.\./.test(value)) notes.push("ASCII-ELLIPSIS");
    if (notes.length) console.log(`${key}: ${notes.join(" | ")}  :: ${JSON.stringify(value)}`);
  }
}
console.log("\n-- narrow-space inventory (U+202F / U+00A0) per fr key --");
for (const ns of namespaces) {
  const fr: Cat = JSON.parse(read(`${ROOT}/src/i18n/catalogues/fr/${ns}.json`));
  for (const [key, value] of Object.entries(fr)) {
    const u202f = [...value].filter((c) => c.codePointAt(0) === 0x202f).length;
    const u00a0 = [...value].filter((c) => c.codePointAt(0) === 0xa0).length;
    const u2019 = [...value].filter((c) => c.codePointAt(0) === 0x2019).length;
    if (u202f || u00a0 || u2019) console.log(`${key}: U+202F=${u202f} U+00A0=${u00a0} U+2019=${u2019}`);
  }
}

// ---- length budgets (UTF-16 .length, the metric the code uses) ----
console.log("\n===== LENGTH BUDGETS =====");
const frHome: Cat = JSON.parse(read(`${ROOT}/src/i18n/catalogues/fr/mobile.home.json`));
const enHome: Cat = JSON.parse(read(`${ROOT}/src/i18n/catalogues/en/mobile.home.json`));
const CHIP_BUDGET = { en: 24, fr: 31 } as const;
const CHIPS = ["mobile.home.suggestion.phone_access", "mobile.home.suggestion.team_of_agents", "mobile.home.suggestion.last_turn", "mobile.home.suggestion.linear_mcp", "mobile.home.suggestion.review_repo", "mobile.home.suggestion.wake_summary"] as const;
const TIPS = ["mobile.home.tip.schedule", "mobile.home.tip.parallel", "mobile.home.tip.search"] as const;
for (const k of CHIPS) console.log(`CHIP fr ${k}: ${frHome[k].length}/${CHIP_BUDGET.fr} ${frHome[k].length <= CHIP_BUDGET.fr ? "OK" : "OVER"}   (en ${enHome[k].length}/${CHIP_BUDGET.en} ${enHome[k].length <= CHIP_BUDGET.en ? "OK" : "OVER"})`);
for (const k of TIPS) console.log(`TIP  fr ${k}: ${frHome[k].length}/48 ${frHome[k].length <= 48 ? "OK" : "OVER"}   (en ${enHome[k].length}/48)`);
// the two home strings the sidecar constrains without a cell number
for (const k of ["mobile.home.starting", "mobile.home.startup_queue.not_started", "mobile.home.connect_disabled_reason"]) {
  console.log(`NOTE fr ${k}: ${frHome[k].length} chars :: ${JSON.stringify(frHome[k])}`);
}
console.log("\n-- widest fr strings in each namespace (fit triage) --");
for (const [ns, cat] of [["mobile.home", frHome], ["mobile.schedules", frSchedules]] as const) {
  const rows = Object.entries(cat).map(([k, v]) => [k, v.length] as const).sort((a, b) => b[1] - a[1]).slice(0, 6);
  console.log(ns + ": " + rows.map(([k, n]) => `${k}=${n}`).join("  "));
}

// ---- technical token preservation ----
console.log("\n===== TECHNICAL TOKEN PRESERVATION =====");
const TOKENS = ["lop mobile", "Local Operator", "Radient", "repo", "Linear MCP", "MCP", "prompt", "MCP"];
for (const ns of namespaces) {
  const en: Cat = JSON.parse(read(`${ROOT}/src/i18n/catalogues/en/${ns}.json`));
  const fr: Cat = JSON.parse(read(`${ROOT}/src/i18n/catalogues/fr/${ns}.json`));
  for (const t of TOKENS) {
    for (const [k, v] of Object.entries(en)) {
      if (!v.includes(t)) continue;
      const fv = fr[k] ?? "";
      console.log(`${k}: token "${t}" en=${v.includes(t)} fr=${fv.includes(t)} :: fr=${JSON.stringify(fv)}`);
    }
  }
}
// code spans / backticks / commands anywhere
console.log("\n-- backticks/commands/URLs in the pair --");
for (const ns of namespaces) {
  const fr: Cat = JSON.parse(read(`${ROOT}/src/i18n/catalogues/fr/${ns}.json`));
  for (const [k, v] of Object.entries(fr)) {
    if (/`|https?:\/\/|\s--[a-z]|\blop\b|%s|\{\{/.test(v)) console.log(`${k}: ${JSON.stringify(v)}`);
  }
}
console.log("\nDONE");

