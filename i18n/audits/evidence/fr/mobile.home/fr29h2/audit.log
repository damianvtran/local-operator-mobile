/**
 * Positive character evidence for the round-2 French audit: for every key,
 * list the non-ASCII codepoints actually present and the banned-character
 * results, so the log proves the state instead of proving a negative by silence.
 */
import { readFileSync } from "node:fs";

const ROOT = "/Users/damian/workspace/mobile-i18n-d5aaf8ba6ba5/mobile-i18n";
const ns = process.argv[2]!;
const fr: Record<string, string> = JSON.parse(readFileSync(`${ROOT}/src/i18n/catalogues/fr/${ns}.json`, "utf8"));
const en: Record<string, string> = JSON.parse(readFileSync(`${ROOT}/src/i18n/catalogues/en/${ns}.json`, "utf8"));

const BIDI = /[\u061C\u200E\u200F\u202A-\u202E\u2066-\u2069]/;
const fmt = (v: string) =>
  [...v]
    .filter((c) => c.codePointAt(0)! > 127)
    .map((c) => `U+${c.codePointAt(0)!.toString(16).toUpperCase().padStart(4, "0")}`)
    .join(" ") || "(ascii only)";

console.log(`== ${ns}: per-key character inventory ==`);
for (const [k, v] of Object.entries(fr)) {
  const flags = [
    v.includes("'") ? "ASCII-APOSTROPHE" : "",
    /"/.test(v) ? "ASCII-QUOTE" : "",
    /\.\.\./.test(v) ? "ASCII-ELLIPSIS" : "",
    BIDI.test(v) ? "BIDI-CONTROL" : "",
  ].filter(Boolean).join(",") || "clean";
  /* a colon/semicolon/question/exclamation must be preceded by U+202F when the
     sentence has a preceding character */
  const spacing: string[] = [];
  for (let i = 1; i < v.length; i++) {
    const c = v[i];
    if (c === ":" || c === ";" || c === "?" || c === "!") {
      const prev = v.codePointAt(i - 1)!;
      spacing.push(`${c}<-U+${prev.toString(16).toUpperCase().padStart(4, "0")}`);
    }
  }
  console.log(`${k}: ${flags} | non-ascii: ${fmt(v)} | ${spacing.length ? "spacing: " + spacing.join(" ") : "no : ; ? !"}`);
}

console.log(`\n== ${ns}: kept-English / product-token inventory ==`);
for (const token of ["lop", "Local Operator", "Radient", "Linear MCP", "repo", "prompt", "surveillance", "réveil", "planification"]) {
  const enHits = Object.entries(en).filter(([, v]) => v.includes(token)).map(([k]) => k);
  const frHits = Object.entries(fr).filter(([, v]) => v.includes(token)).map(([k]) => k);
  console.log(`${token}: en=${enHits.length ? enHits.join(" ") : "absent"} | fr=${frHits.length ? frHits.join(" ") : "absent"}`);
}

