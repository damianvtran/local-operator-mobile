----- run-all.sh -----
#!/bin/bash
# Re-runs every verification command for the ur group A delta audit (round 2); output is the audit.log body.
W=<scratch>/ur-wave
A=<scratch>/ur-audit-a2
cd $W; export HOME=$(mktemp -d)
echo "## date: $(date -u +%FT%TZ)  cwd: $PWD  HOME(scratch): $HOME"
run(){ echo; echo "\$ $*"; "$@" 2>&1; echo "[exit $?]"; }
run git status --short
run git rev-parse --short HEAD
echo; echo '$ sha256 of every group A input (ur, en, en context)'
for ns in mobile.home mobile.session mobile.session_health mobile.account_routing relay.chrome relay.health; do
 for p in ur/$ns.json en/$ns.json en/$ns.context.json; do echo "$(shasum -a 256 src/i18n/catalogues/$p | cut -d' ' -f1)  src/i18n/catalogues/$p"; done; done
run python3 $A/delta.py
run node_modules/.bin/tsx $A/render.ts
run node_modules/.bin/tsx scripts/i18n/generate.ts --check
run node_modules/.bin/tsx scripts/i18n/check-strings.ts
echo; echo '$ python3 scan.py  (bidi controls / redaction markers / Arabic yeh,kaf over every input read)'
cat $A/scan.out

----- delta.py -----
# Delta verification: reconstruct the round-1 bytes by reverting the exact replacement strings from my
# round-1 findings (fixes.json), hash them against round-1 record.json input_hashes, and diff key-by-key.
import json,hashlib
W='<scratch>/ur-wave/'
ids={'mobile.home':'ur30a1','mobile.session':'ur30a2','mobile.session_health':'ur30a3','mobile.account_routing':'ur30a4','relay.chrome':'ur30a5','relay.health':'ur30a6'}
fx=json.load(open('<scratch>/ur-audit-a/fixes.json'))
out={}
for ns,i in ids.items():
    p=f'{W}src/i18n/catalogues/ur/{ns}.json'
    raw=open(p,encoding='utf-8').read(); cur=json.loads(raw)
    rec=json.load(open(f'{W}i18n/audits/evidence/ur/{ns}/{i}/record.json'))
    want=rec['input_hashes']['target']['sha256']; now=hashlib.sha256(raw.encode()).hexdigest()
    old=dict(cur); rev=raw
    for fid,f in fx.get(ns,{}).items():
        if f['replacement'].startswith('(no change'): continue
        if cur[f['key']]==f['replacement']:
            old[f['key']]=f['current']; rev=rev.replace(f['replacement'],f['current'])
    revh=hashlib.sha256(rev.encode()).hexdigest()
    changed=[k for k in cur if cur[k]!=old[k]]
    print(f'{ns}: r1_sha={want[:16]} now_sha={now[:16]} identical={want==now} reverted_sha_matches_r1={revh==want} changed={len(changed)}')
    for k in changed: print('   -',k,'\n      r1 :',old[k],'\n      now:',cur[k])
    # whole-string byte-exact compare against the prescribed replacements
    for fid,f in fx.get(ns,{}).items():
        if f['replacement'].startswith('(no change'): continue
        print(f'   byte-exact {f["key"]}:', cur[f["key"]].encode()==f['replacement'].encode())
    out[ns]=dict(r1=want,now=now,changed=changed)
json.dump(out,open('<scratch>/ur-audit-a2/delta.json','w'),indent=1)

----- render.ts -----
import { readFileSync } from "node:fs";
import { formatMessage, parseMessage, pluralCategory } from "<scratch>/ur-wave/src/i18n/messages";
const C="<scratch>/ur-wave/src/i18n/catalogues/";
const keys:Record<string,string[]>={
 "mobile.home":["connect_disabled_reason","tip.parallel","suggestion.wake_summary"],
 "mobile.session_health":["resume_no_route","resume_gone","still_reopening"],
 "mobile.account_routing":["disconnected"]};
for(const [ns,ks] of Object.entries(keys)){
  const ur=JSON.parse(readFileSync(`${C}ur/${ns}.json`,"utf8")), en=JSON.parse(readFileSync(`${C}en/${ns}.json`,"utf8"));
  for(const k of ks){const K=`${ns}.${k}`;
    console.log(K,"\n  EN:",formatMessage(parseMessage(en[K]),{},"en"),"\n  UR:",formatMessage(parseMessage(ur[K]),{},"ur"),"| len",[...ur[K]].length);}
}
// all home tips / chips lengths
const ur=JSON.parse(readFileSync(`${C}ur/mobile.home.json`,"utf8"));
for(const p of ["tip.","suggestion."]) for(const [k,v] of Object.entries(ur)) if(k.startsWith("mobile.home."+p)) console.log(k,[...(v as string)].length,v);
console.log("pluralCategory ur 0,1,2,21:",[0,1,2,21].map(n=>pluralCategory("ur",n)).join(","));
