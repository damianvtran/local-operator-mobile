# script source:
import json
import sys
import unicodedata

ns = sys.argv[1]
zh = json.load(open(f"/Users/damian/workspace/zh-wave/src/i18n/catalogues/zh-CN/{ns}.json"))

def cells(s):
    n = 0
    for ch in s:
        if unicodedata.east_asian_width(ch) in ("W", "F") or ch in "“”":
            n += 2
        else:
            n += 1
    return n

for key in sorted(zh):
    value = zh[key]
    print(f"{key} chars={len(value)} cells={cells(value)}")
