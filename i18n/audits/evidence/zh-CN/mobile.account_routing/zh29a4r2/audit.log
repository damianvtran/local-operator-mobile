# script source:
import hashlib
import json

BASE = "/Users/damian/workspace/zh-wave"
path = f"{BASE}/src/i18n/catalogues/zh-CN/mobile.account_routing.json"
zh = json.load(open(path))

prior_values = {
    "mobile.account_routing.title": "账号路由",
    "mobile.account_routing.loading": "正在加载账号路由……",
    "mobile.account_routing.load_error": "无法加载账号路由。检查连接后重试。",
    "mobile.account_routing.disconnected": "连接电脑后才能更改账号路由。",
    "mobile.account_routing.unavailable": "此中继不提供账号路由设置。在此电脑上更新Local Operator。",
    "mobile.account_routing.scope": "更改仅应用到此电脑。",
    "mobile.account_routing.saved": "已保存到此电脑。",
}

recon = dict(zh)
recon.update(prior_values)
payload = json.dumps(recon, ensure_ascii=False, indent="\t") + "\n"
recon_hash = hashlib.sha256(payload.encode()).hexdigest()
current_hash = hashlib.sha256(open(path, "rb").read()).hexdigest()
changed = sorted(k for k in zh if zh[k] != recon[k])
joined = "".join(zh.values())
print(f"current target sha256={current_hash}")
print(f"reconstructed prior sha256={recon_hash}")
print(f"matches round-1 target= {recon_hash == '9570e834f23fda2f3d2d948374bebdaf0b2e7ddd196da7e605d432c4f059dfb0'}")
print(f"changed_keys={changed}")
print(f"changed_count={len(changed)} unchanged_count={len(zh) - len(changed)}")
print(f"账户 occurrences={joined.count('账户')} 账号 occurrences={joined.count('账号')} 帐户 occurrences={joined.count('帐户')}")
print(f"title={zh['mobile.account_routing.title']}")
print(f"scope={zh['mobile.account_routing.scope']}")
print(f"saved={zh['mobile.account_routing.saved']}")
