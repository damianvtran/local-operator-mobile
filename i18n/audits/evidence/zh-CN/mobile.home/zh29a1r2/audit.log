# script source:
import hashlib
import json

BASE = "/Users/damian/workspace/zh-wave"
path = f"{BASE}/src/i18n/catalogues/zh-CN/mobile.home.json"
zh = json.load(open(path))
prior = dict(zh)
prior["mobile.home.options.fixed"] = "此对话的起始选项已固定。实时控制项请在“对话详情”中查看。"
payload = json.dumps(prior, ensure_ascii=False, indent="\t") + "\n"
recon_hash = hashlib.sha256(payload.encode()).hexdigest()
current_hash = hashlib.sha256(open(path, "rb").read()).hexdigest()
changed = sorted(k for k in zh if zh[k] != prior[k])
print(f"current target sha256={current_hash}")
print(f"reconstructed prior sha256={recon_hash}")
print(f"matches round-1 target= {recon_hash == '24f80843f29ec7687e335f06d412f4add6284f0de837e82e71f741945f5bf033'}")
print(f"changed_keys={changed}")
print(f"changed_count={len(changed)} unchanged_count={len(zh) - len(changed)}")
print(f"review_repo={zh['mobile.home.suggestion.review_repo']}")
print(f"review_repo_hash={hashlib.sha256(zh['mobile.home.suggestion.review_repo'].encode()).hexdigest()}")

session = json.load(open(f"{BASE}/src/i18n/catalogues/zh-CN/mobile.session.json"))
label = session["mobile.session.conversation_details"]
fixed = zh["mobile.home.options.fixed"]
print(f"conversation_details={label!r} codepoints={[hex(ord(c)) for c in label]}")
print(f"options.fixed={fixed!r}")
print(f"quoted substring present={'“' + label + '”' in fixed}")
print(f"bare substring present={label in fixed}")
