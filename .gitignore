# Dependencies
# Directories and symlinks: a worktree's `node_modules` is often a link to a
# shared tree, and `node_modules/` (with the slash) does not match a symlink.
node_modules
.pnpm-store/
.pnpm-debug.log*

# Ruby / fastlane. `.github/actions/setup-fastlane` installs the pinned Gemfile
# with `bundle config set --local path vendor/bundle`, so a CI job grows a gem tree
# at the repository root. It is an install artefact, never source; `metro.config.js`
# blocks the same path, because a signed iOS archive bundles the JS while the tree
# is sitting there. Anchored to the root: a dependency's own `vendor/bundle` is
# part of that dependency.
/vendor/bundle/

# Expo / React Native
.expo/
.expo-shared/
expo-env.d.ts
web-build/
.metro-health-check*
*.tsbuildinfo

# Build outputs
dist/
build/
artifacts/
*.ipa
*.apk
*.aab
*.app
*.dSYM/
*.dSYM.zip

# iOS
ios/Pods/
ios/build/
ios/DerivedData/
Pods/
*.xcuserstate
xcuserdata/
*.hmap

# Android
android/.gradle/
android/build/
android/app/build/
android/.cxx/
.gradle/
.kotlin/
.cxx/
local.properties
captures/

# Signing material — never commit; release signing runs in CI from secrets
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
*.provisionprofile
*.pem
google-services.json
GoogleService-Info.plist

# Environment files
.env
.env.*
!.env.example
!.env.*.example

# Testing and coverage
coverage/
test-results/
playwright-report/
.maestro/output/
maestro-output/

# Python (the CI proof tooling is Python; bytecode is a build artefact)
__pycache__/
*.pyc

# Logs
*.log
# ...except the audit evidence bundles: their execution logs ARE the record.
# A blanket `*.log` silently dropped every audit.log from a commit while
# record.json and report.md landed, so the bundle was committed incomplete.
!i18n/audits/evidence/**/audit.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
