{
	"name": "local-operator-mobile",
	"version": "0.0.0",
	"private": true,
	"description": "Native iOS and Android client for the Local Operator mobile relay",
	"license": "MIT",
	"packageManager": "pnpm@12.6.0",
	"main": "expo-router/entry",
	"scripts": {
		"dev": "expo start",
		"dev:web": "expo start --web",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"export:web": "expo export --platform web",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format:check": "biome format .",
		"format:fix": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"theme:build": "node scripts/build-theme.mjs",
		"theme:check": "node scripts/build-theme.mjs --check",
		"contrast:check": "node design/tokens/contrast-contract.mjs",
		"preset:check": "node design/tokens/build-preset.mjs --check"
	},
	"dependencies": {
		"@expo/metro-runtime": "~57.0.16",
		"eventsource-parser": "4.1.1",
		"expo": "57.0.26",
		"expo-clipboard": "~57.0.2",
		"expo-constants": "~57.0.20",
		"expo-crypto": "~57.0.3",
		"expo-font": "~57.0.4",
		"expo-haptics": "~57.0.3",
		"expo-image": "~57.0.5",
		"expo-linking": "~57.0.11",
		"expo-router": "~57.0.24",
		"expo-secure-store": "~57.0.4",
		"expo-splash-screen": "~57.0.9",
		"expo-status-bar": "~57.0.1",
		"expo-web-browser": "~57.0.3",
		"lucide-react-native": "1.49.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.3",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.2",
		"react-native-svg": "15.15.4",
		"react-native-web": "^0.21.3",
		"uniwind": "1.12.0",
		"zod": "4.6.5",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@types/node": "^26.6.3",
		"@biomejs/biome": "2.5.14",
		"@types/react": "^19.3.0",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.2"
	}
}
