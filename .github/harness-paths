# Harness/ship manifest — read by the harness delta proof
# (`scripts/harness_delta_proof.py` in damianvtran/local-operator).
#
# WHY THIS EXISTS. PR #156 took 40 agent-review rounds; round 3 was already
# clean and the last product-code commit landed on 11-05, yet every push to the
# native proof harness reopened a numbered round. After a clean code round, a
# delta that touches ONLY `harness:` paths, changes this file not at all, and
# touches nothing the shipping pipeline reads is settled by one
# `### Harness delta check` at the merge gate instead of a new round
# (AGENTS.md, "Commits and pull requests").
#
# HOW TO READ IT.
# - Anything NOT matched by a `harness:` glob is product. One changed product
#   byte opens a round. Unlisted means product, so forgetting an entry is safe.
# - `ship:` lists what the shipping pipeline (release.yml and everything it
#   calls) reads. When a path matches both, the MORE SPECIFIC glob wins (longer
#   literal prefix; ties go to ship), so `ship: scripts/ci/version.test.ts`
#   overrides `harness: scripts/ci/**`. Being NAMED by a ship file (path,
#   basename, import/require/source specifier) also makes a harness file product.
# - The proof fails closed: anything it cannot read or resolve is a round. With
#   no proof output there is no carve-out — the delta gets a normal round.
# - THE scripts/ci/** GLOB IS NOT AN EXEMPTION for the scripts release.yml runs.
#   Reachability makes them product. A rule keyed on directories alone is the
#   path classifier that already failed in the Minerva SDLC skill; the ship
#   entries below are what stop it failing again here.
# - This file is product: changing it always opens a round, so the exemption
#   set cannot grow without review.
#
# Globs: `**` = any depth, `*` = within one path segment.

# --- ship: what release.yml reads, directly or through what it calls --------

# The release pipeline itself.
ship: .github/workflows/release.yml
# ci.yml is a GATE, not a ship input: release.yml calls it only to decide
# whether to ship, and consumes nothing it produces (checked 2026-11-06):
#   release.yml:211-218  gate: needs: [version, credentials] … uses: ./.github/workflows/ci.yml
#   release.yml:222/332  android/ios: needs: [version, credentials, gate]  (no needs.gate.outputs)
#   release.yml:414      publish: if: … needs.gate.result == 'success' …  (result only)
#   release.yml:426-436  download-artifact name: android-release / ios-ipa — produced by
#                        the android/ios jobs; ci.yml uploads only web-export,
#                        android-release-probe, ios-ipa-probe, design-previews.
# A gate file is still a product path (editing it opens a round), but its text
# does not seed the ship closure, so the scripts it runs can be harness. The
# merge-gate `### Harness delta check` reads changed `gate-run` harness files with
# the full review lens, not only for gate weakening.
# Residual channel, for the manifest reviewer: ci.yml's `setup-node cache: pnpm`
# and release.yml:242/350's share the pnpm store cache (lockfile-keyed;
# `pnpm install --frozen-lockfile` checks integrity against pnpm-lock.yaml).
gate: .github/workflows/ci.yml
# Composite actions release.yml uses to build, sign and upload.
ship: .github/actions/**
# Native gates: ios.yml can sign and upload to TestFlight from main, and both
# build the same native projects release.yml builds.
ship: .github/workflows/ios.yml
ship: .github/workflows/android.yml
# Scripts release.yml (or its actions) runs: version and build number, platform
# selection, Xcode project edits, signing, notes, asset staging, secret checks.
ship: scripts/ci/version.ts
ship: scripts/ci/release-platforms.ts
ship: scripts/ci/ios-project.ts
ship: scripts/ci/ios-signing.py
ship: scripts/ci/release-notes.ts
ship: scripts/ci/stage-release-assets.sh
ship: scripts/ci/check-secrets.ts
# Tests of those scripts. ci.yml (called by release.yml) runs them via
# `pnpm test`; a skipped assertion here weakens the release gate, so they are
# product, not harness (round 1, Q-M1).
ship: scripts/ci/version.test.ts
ship: scripts/ci/release-platforms.test.ts
ship: scripts/ci/release-notes.test.ts
ship: scripts/ci/stage-release-assets.test.ts
ship: scripts/ci/ios-signing-test.py
ship: scripts/ci/fastlane-path-test.rb
# The app: source, routes, native modules, config plugins, assets, strings.
ship: app/**
# src/ is listed per directory. `ship: src/**` would classify the same way
# (src/testing/** is more specific), but the explicit list keeps every shipped
# directory's imports in the reachability scan by construction. Add any NEW
# top-level src/ directory here; an unlisted one is still product.
ship: src/*
ship: src/connection/**
ship: src/contracts/**
ship: src/e2e/**
ship: src/features/**
ship: src/i18n/**
ship: src/lib/**
ship: src/notifications/**
ship: src/relay/**
ship: src/state/**
ship: src/stt/**
ship: src/ui/**
ship: modules/**
ship: plugins/**
ship: assets/**
ship: i18n/**
# Build inputs: dependencies, Expo/EAS/bundler config, entry points.
ship: package.json
ship: pnpm-lock.yaml
ship: pnpm-workspace.yaml
ship: app.json
ship: app.config.*
ship: eas.json
ship: babel.config.*
ship: metro.config.*
ship: index.*
# Store upload lanes, store metadata and the build-number floor.
ship: fastlane/**
ship: store/**
ship: release/**

# --- harness: proof and test tooling that never ships ------------------------

harness: scripts/ci/**
harness: src/testing/**
harness: tools/mock-relay/**
harness: e2e/**
# Evidence-only workflows, by EXACT filename: a glob such as *-proof.yml would
# exempt a NEW workflow that runs on tags with signing secrets (round 1, M3).
# A new workflow is product until it is listed here, which is itself a round.
# None of these is called by release.yml (checked 2026-11-06).
harness: .github/workflows/e2e.yml
harness: .github/workflows/flake-report.yml
harness: .github/workflows/oauth-callback-proof.yml
harness: .github/workflows/android-oauth-callback-proof.yml
harness: .github/workflows/signin-app-proof.yml
# Forward declaration for PR #156 (Stage B draft recovery), which adds it:
# triggers pull_request + workflow_dispatch only, uploads evidence artifacts
# only, uses no secrets, and release.yml does not name it (verified on
# refs/pull/156/head). Declared here so that PR's proof iterations are
# harness-only rather than a numbered round each.
harness: .github/workflows/stage-b-draft-proof.yml
