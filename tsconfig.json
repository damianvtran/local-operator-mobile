{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"exactOptionalPropertyTypes": false,
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"module": "esnext",
		"target": "esnext",
		"lib": ["esnext", "dom"],
		"types": ["react"],
		"allowJs": false,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"noEmit": true,
		// Reader integration tests import the real Node-run mock relay. Its
		// explicit .ts specifiers are required by Node; noEmit makes accepting
		// them safe in the app's typecheck too (there is no emitted JS to fix).
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"app/**/*.ts",
		"app/**/*.tsx",
		"*.ts",
		"*.js",
		".expo/types/**/*.ts",
		"expo-env.d.ts"
	],
	"exclude": ["node_modules", "dist", "design", "docs"]
}
